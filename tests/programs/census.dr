// Enough processes finished for the native runtime to take a census of the shared region and
// reap the processes nobody can join any more, and then everything that must have survived it:
// a pid kept the whole time, a pid that only ever travelled in a message, a monitor set up after,
// a CAF read throughout. What a census may drop is only what no process could ever ask for.
import std.console;
import std.list;
import std.proc;

let table = list.map (fn i -> i * 3) (list.range 0 1000);

let rec batches! n !acc = if n == 0 { acc } else {
    let ps = list.forced (list.map (fn! i -> spawn! $( list.map (fn j -> j + i) (list.range 0 20) )) (list.range 0 1000));
    let s = list.sum (list.map (fn! p -> list.sum (join! p)) ps);
    batches! (n - 1) (acc + s + list.sum table)
};

let holder! () = {
    let p = recv! ();
    let back = recv! ();
    send! back p
};

let main! = {
    let kept = spawn! $( list.range 0 10 );
    // A pid held only by another process, in its heap and then in a message.
    let h = spawn! $( holder! () );
    send! h (spawn! $( [:hidden, list.sum table] ));
    console.print! (batches! 80 0)
    console.print! (join! kept)
    send! h (self! ());
    console.print! (join! (recv! ()))
    // A monitor of a process that finished long ago still says how it finished.
    proc.monitor! kept
    console.print! (proc.recv_where! (fn m -> proc.is_down_of kept m) |> (fn d -> d.[0]))
    console.print! (list.sum table)
};
