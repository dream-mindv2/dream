// Processes are isolated and communicate only by copied messages.
import std.console;

let echo! () = {
    let msg = recv! ();
    let from = recv! ();
    send! from msg
};

let adder! total = {
    let n = recv! ();
    if n <= 0 { total } else { adder! (total + n) }
};

let main! = {
    let me = self! ();

    // Round trip a value through another process.
    let e = spawn! $(echo! ());
    send! e :ping
    send! e me
    console.print! ("echoed:    " + to_string (recv! ()))

    // A process's result is delivered to whoever joins it.
    let w = spawn! $( 6 * 7 );
    console.print! ("joined:    " + to_string (join! w))

    // Failure in one process does not take down the one that joins it.
    let bad = spawn! $( 1 / 0 );
    let caught = try! { join! bad } catch err { :handled };
    console.print! ("join fail: " + to_string caught)
}
