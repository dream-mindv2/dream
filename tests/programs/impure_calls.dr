// One implementation can be called purely or sequenced with `!`.
import std.console;
import std.list;
import std.list.{all as every};
import std.list.{head! as front};
import std.math;

let visit! x = { console.print! x; x < 3 };
let identity x = x;
let choose x = :pure;
let choose! x = :explicit;
let first xs = xs.[0];
let run! f x = f! x;

let main! = {
    console.print! (list.all (fn x -> x > 0) [1, 2]);
    // These results are deliberately unused; their effects belong here.
    let ignored = list.all! visit! [1, 2, 3, 4];
    console.print! :after_all;
    let ignored_alias = every! visit! [1, 2];
    console.print! :after_alias;
    let ignored_inline = list.all! (fn x -> { console.print! x; x < 2 }) [1, 2, 3];
    console.print! :after_inline;

    // Inlining a wrapper must preserve the sequencing on its call.
    let cells = [console.print! :first];
    let ignored_first = first! cells;
    console.print! :after_first;
    let other_cells = [console.print! :head];
    let ignored_head = list.head! other_cells;
    console.print! :after_head;
    let alias_cells = [console.print! :front];
    let ignored_front = front alias_cells;
    console.print! :after_front;

    console.print! (identity! 7);
    console.print! (choose! ());
    console.print! (len! [1, 2, 3]);
    console.print! (math.abs! (0 - 4));
    console.print! (math.abs (0 - 5));
    let host = math;
    console.print! (host.abs! (0 - 6));
    console.print! (run! identity 8);
    let local x = x + 1;
    console.print! (local! 9);
    let captured! x = local! x;
    console.print! (captured! 10);
    // Standard shorthand still selects the right implementation by type.
    console.print! (map! (fn x -> x + 1) [1, 2]);
    let partial! = list.all! visit!;
    console.print! (partial! [1, 3, 4]);
};
