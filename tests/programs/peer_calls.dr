// A compiled function calling another compiled function.
//
// The tier used to compile exactly one Dream-level call -- this function
// calling itself -- so a loop whose body named a helper was not compiled at
// all, however hot it got. It now emits the callee beside the caller and calls
// it with the arguments in registers: no frame, no thunk, no trip through the
// interpreter. `PeerSet` in dream/src/jit.cpp is the rule, and what is below is
// the rule's consequences.
//
// Everything here runs under both tiers and the two must agree, which is the
// only check that matters: the answers are what the interpreter gives, and a
// compiled call that changed one of them would be a broken JIT. Three of these
// are cases where the tier has to *decline* -- a callee that is not strict in
// every parameter, a callee that is a loop, and a callee reached through
// something that is not a global name -- and for those the point is that the
// program still says what it always said.

import std.console;

import std.list;

// --- the plain case: a loop that names a helper ----------------------------
let square x = x * x;
let rec sumsq i n acc = if i > n { acc } else { sumsq (i + 1) n (acc + square i) };

// --- a helper that recurses, which is what `collatz` in the benchmark is ---
let rec steps n = if n == 1 { 0 } else { 1 + steps (if n % 2 == 0 { n / 2 } else { 3 * n + 1 }) };
// And through a fused pipeline, which is the shape the benchmark actually
// writes: the fold becomes a loop, and the loop's body calls `steps`.
let collatz n = list.fold_strict (fn acc x -> acc + steps x) 0 (list.range 1 (n + 1));

// --- mutual recursion, which needs both halves declared before either is
// written, and which is a tail call in both directions -- so it is a machine
// call that goes as deep as the arithmetic says and hands itself to the
// interpreter when the machine stack runs out.
let rec is_even n = if n == 0 { true } else { is_odd (n - 1) };
let rec is_odd n = if n == 0 { false } else { is_even (n - 1) };
let rec evens i n acc =
    if i > n { acc } else { evens (i + 1) n (if is_even i { acc + 1 } else { acc }) };
// The same pair, asked to go deeper than the machine stack a compiled
// recursion is given: two tail calls that are machine calls here rather than
// loop back-edges, so the depth is real and `JIT_DEEP` is what stops it.
let deep_even n = is_even n;

// --- a chain of helpers, each calling the next -----------------------------
let third x = x + 1;
let second x = third x * 2;
let first x = second x - 3;
let rec chain i n acc = if i > n { acc } else { chain (i + 1) n (acc + first i) };

// --- a helper that raises. The error has to be the one the interpreter
// raises, at the element that raises it, with everything before it done.
let recip x = 100 / x;
let rec divide i n acc = if i > n { acc } else { divide (i + 1) n (acc + recip i) };

// --- a helper whose answer is a float, which crosses the line between a
// value in a register and a value in a box.
let scale x = x * 1.5;
let rec scaled i n acc = if i > n { acc } else { scaled (i + 1) n (acc + scale i) };

// --- a helper deeper than the machine stack a compiled recursion is given.
// It answers `JIT_DEEP`, which travels up through the caller, and the
// interpreter runs the call instead -- and must get the same number.
let rec descend n = if n == 0 { 0 } else { 1 + descend (n - 1) };
let rec descends i n acc = if i > n { acc } else { descends (i + 1) n (acc + descend 40000) };

// --- what must be declined ------------------------------------------------
//
// `pick` does not force `a` or `b` on every path, so a caller may not evaluate
// them before calling it. If the tier took this call the `1 / 0` below would be
// evaluated on every iteration and the loop would raise; the answer says it is
// not.
let pick c a b = if c { a } else { b };
let rec choose i n acc =
    if i > n { acc } else { choose (i + 1) n (acc + pick (i > 0) i (1 / 0)) };

// A callee that is a loop is declined too, for a different reason: a compiled
// loop stays preemptible by writing its state back to its frame, and a callee
// is given no frame. It still runs, and still answers.
let rec countdown n acc = if n == 0 { acc } else { countdown (n - 1) (acc + 1) };
let rec counts i n acc = if i > n { acc } else { counts (i + 1) n (acc + countdown 4 0) };

// A callee reached through a parameter rather than a global name is not a name
// the tier can resolve, so it is declined -- and `choose` above shows why that
// matters: nothing about the call site says what is being called.
let rec applied f i n acc = if i > n { acc } else { applied f (i + 1) n (acc + f i) };

let show! name v = console.print! (name + " = " + to_string (try! { strict! v } catch e { e }));

let main! = {
    show! "sumsq"    (sumsq 1 20000 0);
    show! "collatz"  (collatz 2000);
    show! "evens"    (evens 1 600 0);
    show! "deep"     (deep_even 40000);
    show! "chain"    (chain 1 20000 0);
    show! "divide"   (divide 1 20000 0);
    show! "divide-0" (divide 0 20000 0);
    show! "scaled"   (scaled 1 20000 0.0);
    show! "descends" (descends 1 3 0);
    show! "choose"   (choose 1 20000 0);
    show! "counts"   (counts 1 20000 0);
    show! "applied"  (applied square 1 20000 0);
};
