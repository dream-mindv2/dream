// Strict parameters: `!acc` and `(strict acc)`.
//
// A strict parameter is forced when the function is entered, which is what
// keeps an accumulator from becoming a chain of suspended additions. What must
// hold under both tiers:
//
//   * a loop whose accumulator is strict does not overflow however long it
//     runs, where the same loop with a lazy one does under the interpreter;
//   * both spellings, in a `let` and in a `fn`;
//   * a strict parameter is forced even when the body never looks at it, and
//     strict parameters are forced in the order they are written;
//   * `(strict)` alone is still a parameter named `strict`.

import std.console;
import std.list;

let rec poly !acc n = if n == 0 { acc } else { poly (acc + n * 2) (n - 1) };
let rec worded (strict acc) n = if n == 0 { acc } else { worded (acc + n * 2) (n - 1) };
let folded = list.fold (fn !acc x -> acc + x * 2) 0 (list.range 0 300000);

let ignores !x y = y;
let both !a !b = 0;
let named (strict) = strict + 1;
let mixed !n [a, b] = n + a + b;

let main! = {
    console.print! (poly 0 300000)
    console.print! (worded 0 300000)
    console.print! folded
    console.print! (try! { ignores (1 / 0) 5 } catch e { e })
    console.print! (try! { both (raise! :first) (raise! :second) } catch e { e })
    console.print! (named 41)
    console.print! (mixed 1 [2, 3])
};
